generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  CONFIRMED
  UNCONFIRMED
  CANCELLED
}

enum FlightDirection {
  OUTBOUND
  RETURN
  OTHER
}

enum TransferType {
  VIP
  PRIVATE
  SHARED
}

enum FileType {
  FLIGHT
  HOTEL
  TRANSFER
  OTHER
}

model Customer {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id                String        @id @default(cuid())
  pnr               String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destination       String
  destinationCountry String?
  price             Decimal       @default(0) @db.Decimal(10, 2)
  currency          String        @default("USD")
  status            BookingStatus @default(UNCONFIRMED)
  startDate         DateTime?
  endDate           DateTime?
  notes             String?
  flights           Flight[]
  hotels            Hotel[]
  transfers         Transfer[]
  terms             BookingTerm[]
  files             UploadedFile[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([customerId])
  @@index([destination])
}

model Flight {
  id                  String          @id @default(cuid())
  bookingId           String
  booking             Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  direction           FlightDirection @default(OUTBOUND)
  airlineName         String?
  departureAirport    String
  arrivalAirport      String
  departureDateTime   DateTime
  arrivalDateTime     DateTime?
  flightNumber        String?
  airlinePnr          String?
  baggage             String?
  notes               String?
  createdAt           DateTime        @default(now())
}

model Hotel {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelName   String
  stars       Int?
  roomType    String?
  mealPlan    String?
  checkIn     DateTime?
  checkOut    DateTime?
  nights      Int?
  address     String?
  createdAt   DateTime @default(now())
}

model Transfer {
  id                String       @id @default(cuid())
  bookingId         String
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pickupLocation    String
  dropoffLocation   String
  transferDateTime  DateTime?
  transferType      TransferType @default(PRIVATE)
  notes             String?
  createdAt         DateTime     @default(now())
}

model DefaultTerm {
  id        String   @id @default(cuid())
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BookingTerm {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model UploadedFile {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  fileType  FileType @default(OTHER)
  fileUrl   String
  createdAt DateTime @default(now())
}
